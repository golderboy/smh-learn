log_format smh_public escape=json '{"status":$status,"method":"$request_method","duration_seconds":$request_time}';
server {
    listen 80;
    listen [::]:80;
    server_name learning.example.org;
    access_log /var/log/nginx/smh-access.log smh_public;
    error_log /var/log/nginx/smh-error.log crit;
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://learning.example.org$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name learning.example.org;
    ssl_certificate /etc/letsencrypt/live/learning.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/learning.example.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 110M;
    access_log /var/log/nginx/smh-access.log smh_public;
    error_log /var/log/nginx/smh-error.log crit;
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 200s;
        proxy_send_timeout 200s;
    }
}

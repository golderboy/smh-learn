APP_NAME="SMH Learning DEV"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8088
APP_PORT=8088
APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=smh_learning_dev
DB_USERNAME=smh_dev
DB_PASSWORD=
DB_FORWARD_PORT=33068
MARIADB_ROOT_PASSWORD=
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=smh_learning_dev_
MAIL_MAILER=log
FILESYSTEM_DISK=local
VITE_APP_NAME="${APP_NAME}"

# Local identity policy; never use demo credentials for deployment.
INITIAL_USER_PASSWORD=smh123456
REQUIRE_INITIAL_PASSWORD_CHANGE=true
THAID_ENABLED=false
THAID_ISSUER=
